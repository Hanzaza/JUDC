# ==============================================================================
# OPTIFLOW AI - VARIABLES DE ENTORNO SUPABASE
# ==============================================================================
# Copia este archivo a .env o .env.local para que Vite cargue tus credenciales
# automáticamente al iniciar el servidor de desarrollo.

# URL del proyecto Supabase (ej: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Anon / Public Key de Supabase (Project Settings -> API -> anon public)
VITE_SUPABASE_ANON_KEY=
